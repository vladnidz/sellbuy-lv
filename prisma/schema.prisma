generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider          = "postgresql"
  extensions        = [ltree()]
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  name          String?
  listings      Listing[]
  chats         Chat[]
  buyerRatings  Rating[] @relation("BuyerRatings")
  sellerRatings Rating[] @relation("SellerRatings")
}

model Rating {
  id        String   @id @default(uuid())
  score     Int
  comment   String?
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id])
  buyerId   String
  buyer     User     @relation("BuyerRatings", fields: [buyerId], references: [id])
  sellerId  String
  seller    User     @relation("SellerRatings", fields: [sellerId], references: [id])
  createdAt DateTime @default(now())
}

model Category {
  id         String               @id @default(uuid())
  name       String
  nameLv     String?
  nameRu     String?
  nameEn     String?
  attributes Json?
  path       Unsupported("ltree") @unique
  parentId   String?
  parent     Category?            @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children   Category[]           @relation("CategoryHierarchy")
  listings   Listing[]

  @@index([path], type: Gist)
}

model Listing {
  id          String   @id @default(uuid())
  title       String
  description String @default("")
  price       Decimal
  images      String[] @default([])
  city        String?
  attributes  Json?
  category    Category @relation(fields: [categoryId], references: [id])
  categoryId  String
  author      User     @relation(fields: [authorId], references: [id])
  authorId    String
  createdAt   DateTime @default(now())
}

model Chat {
  id           String    @id @default(uuid())
  participants User[]
  messages     Message[]
}

model Message {
  id       String @id @default(uuid())
  chat     Chat   @relation(fields: [chatId], references: [id])
  chatId   String
  senderId String
  content  String
}
